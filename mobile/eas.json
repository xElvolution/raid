{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8787",
        "EXPO_PUBLIC_DEMO_LOGIN": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://called.5.189.170.85.sslip.io",
        "EXPO_PUBLIC_WEB_URL": "https://called.5.189.170.85.sslip.io",
        "EXPO_PUBLIC_DEMO_LOGIN": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://called.5.189.170.85.sslip.io",
        "EXPO_PUBLIC_WEB_URL": "https://called.5.189.170.85.sslip.io",
        "EXPO_PUBLIC_DEMO_LOGIN": "0"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "REPLACE_APPLE_ID",
        "ascAppId": "REPLACE_ASC_APP_ID",
        "appleTeamId": "REPLACE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}