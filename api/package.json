{
  "name": "@called/api",
  "version": "0.1.0",
  "private": true,
  "description": "Called API: REST + realtime WebSockets, indexer, job queues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@called/sdk": "file:../sdk",
    "@ethersproject/wallet": "^5.8.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/websocket": "^11.3.4",
    "bs58": "^6.0.0",
    "bullmq": "^6.3.19",
    "ethers": "^6.17.0",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "near-api-js": "^5.1.1",
    "pg": "^8.23.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
