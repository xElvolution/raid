PORT=8787
DATABASE_URL=postgres://user:pass@host/called
# optional read replica; reads fall back to primary
DATABASE_REPLICA_URL=
REDIS_URL=redis://localhost:6379
# >= 32 chars, random
JWT_SECRET=
NEAR_RPC_URL=https://rpc.testnet.near.org
SIGNIN_RECIPIENT=called.testnet
# real-money external routes return 451 here (points mode)
BLOCKED_COUNTRIES=US
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# workers (npm run worker)
RESOLVER_URL=http://localhost:8788
RESOLVER_TOKEN=
# optional: Expo push security token
EXPO_ACCESS_TOKEN=
POLYMARKET_SYNC_MS=30000
